{
  "info": {
    "name": "QuickBite CP2 — Sierra-Lima (Menu + Restaurant)",
    "_postman_id": "8a8a8a8a-cb02-4cb2-9b9b-quickbite-cp2",
    "description": "Pre-baked CP2 verification flow for the QuickBite stack at commit 3d26d05 (Menu + Restaurant services owned by Sierra-Lima). Mirrors the README §1–§4 checklist:\n\n- Folder **Item A** — public reads against both services prove A=4: \"Second Responsibility runs (A+B+D from CP1)\".\n- Folder **Item B** — owner / non-owner POST proves the live cross-service ownership lookup is real and not mocked (B=2).\n- Folder **B2B endpoints** — `validate` and `availability` are the W1 hops Order Service consumes.\n- Folder **Negative auth** — confirms the JWT filter rejects missing / wrong-issuer tokens.\n\nNo Python required. Each authenticated request mints its own fresh HS256 JWT inline using Postman's bundled `crypto-js`, signed with the dev secret pinned in `application.properties`. Inlining the mint per-request (rather than running it once collection-wide) keeps the actor identity local to the request, which is what makes the owner-1 vs owner-2 contrast in folder Item B work.\n\nPrerequisite: stack is up via `docker compose up -d --build` from the repo root (or with `RESTAURANT_DB_HOST_PORT` / `MENU_DB_HOST_PORT` overrides if 5432/5433 are taken).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl",     "value": "http://localhost:8080", "type": "string" },
    { "key": "frontendUrl",    "value": "http://localhost:8090", "type": "string" },
    { "key": "restaurantId",   "value": "d0000001-0000-0000-0000-000000000001", "type": "string", "description": "Pizza Antonio (open) — owned by user-0001" },
    { "key": "restaurantId2",  "value": "d0000003-0000-0000-0000-000000000003", "type": "string", "description": "Cafe Nero (closed) — owned by user-0002" },
    { "key": "menuItemId",     "value": "e0000011-0000-0000-0000-000000000011", "type": "string", "description": "Margherita @ Pizza Antonio" },
    { "key": "jwtSecret",      "value": "test-secret-for-dev-only-do-not-use-in-prod-123456", "type": "string", "description": "Decoded form of jwt.secret in application.properties; HMAC-SHA256 key" },
    { "key": "jwtIssuer",      "value": "quickbite-user-service", "type": "string" },
    { "key": "userOwner1",     "value": "00000000-0000-0000-0000-000000000001", "type": "string", "description": "Owns d0000001 + d0000002" },
    { "key": "userOwner2",     "value": "00000000-0000-0000-0000-000000000002", "type": "string", "description": "Owns d0000003 + d0000004 (NOT d0000001)" },
    { "key": "userCustomer",   "value": "00000000-0000-0000-0000-0000000000c1", "type": "string" },
    { "key": "userAdmin",      "value": "00000000-0000-0000-0000-0000000000a1", "type": "string" }
  ],
  "item": [
    {
      "name": "Item A — Persistence (public reads)",
      "item": [
        {
          "name": "GET /restaurants?size=2  (paged list, seeded)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/restaurants?size=2", "host": ["{{gatewayUrl}}"], "path": ["restaurants"], "query": [ { "key": "size", "value": "2" } ] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('paged envelope', () => pm.expect(j).to.have.property('content').that.is.an('array'));",
              "pm.test('seed data present', () => pm.expect(j.totalElements).to.be.greaterThan(0));"
            ]}
          }]
        },
        {
          "name": "GET /restaurants/{{restaurantId}}  (Pizza Antonio)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('matching restaurantId', () => pm.expect(j.restaurantId).to.eql(pm.collectionVariables.get('restaurantId')));",
              "pm.test('ownerId is user-0001', () => pm.expect(j.ownerId).to.eql(pm.collectionVariables.get('userOwner1')));"
            ]}
          }]
        },
        {
          "name": "GET /restaurants/{{restaurantId}}/menu-items  (4 seeded items)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/menu-items", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "menu-items"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('returns an array', () => pm.expect(j).to.be.an('array'));",
              "pm.test('seed items present (>= 4)', () => pm.expect(j.length).to.be.at.least(4));"
            ]}
          }]
        },
        {
          "name": "GET /menu-items/{{menuItemId}}  (Margherita)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/menu-items/{{menuItemId}}", "host": ["{{gatewayUrl}}"], "path": ["menu-items", "{{menuItemId}}"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Margherita', () => pm.expect(pm.response.json().name).to.eql('Margherita'));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "Item B — Live cross-service integration (real call, not mocked)",
      "item": [
        {
          "name": "POST /restaurants/{{restaurantId}}/menu-items as owner-1  (expect 201)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// Mint owner-1 JWT inline so the actor identity is set",
                "// before {{jwt}} is interpolated into the Authorization header.",
"const ACTOR = pm.collectionVariables.get('userOwner1');",
                "const ROLE  = 'RestaurantOwner';",
                "function b64url(wa) {",
                "    return CryptoJS.enc.Base64.stringify(wa)",
                "        .replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "}",
                "const now = Math.floor(Date.now()/1000);",
                "const hdr = JSON.stringify({ alg:'HS256', typ:'JWT' });",
                "const pld = JSON.stringify({",
                "    iss: pm.collectionVariables.get('jwtIssuer'),",
                "    sub: ACTOR, userId: ACTOR, role: ROLE, tokenType: 'USER',",
                "    iat: now, exp: now + 3600",
                "});",
                "const h = b64url(CryptoJS.enc.Utf8.parse(hdr));",
                "const p = b64url(CryptoJS.enc.Utf8.parse(pld));",
                "const si = h + '.' + p;",
                "const sig = b64url(CryptoJS.HmacSHA256(si, pm.collectionVariables.get('jwtSecret')));",
                "pm.variables.set('jwt', si + '.' + sig);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "const j = pm.response.json();",
                "pm.test('returned restaurantId matches request', () => pm.expect(j.restaurantId).to.eql(pm.collectionVariables.get('restaurantId')));",
                "pm.test('persisted menuItemId', () => pm.expect(j.menuItemId).to.match(/^[0-9a-f-]{36}$/));"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman positive {{$timestamp}}\",\n  \"description\": \"Created via the CP2 Postman collection (owner-1, expect 201).\",\n  \"priceAmount\": 1.00,\n  \"priceCurrency\": \"EUR\",\n  \"category\": \"Main\",\n  \"isAvailable\": true\n}" },
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/menu-items", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "menu-items"] }
          }
        },
        {
          "name": "POST /restaurants/{{restaurantId}}/menu-items as owner-2  (expect 403)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// Mint owner-2 JWT inline. owner-2 owns d0000003 / d0000004,",
                "// NOT d0000001, so the live ownership lookup in menu-service",
                "// will return ...0001 and the request fails 403.",
"const ACTOR = pm.collectionVariables.get('userOwner2');",
                "const ROLE  = 'RestaurantOwner';",
                "function b64url(wa) {",
                "    return CryptoJS.enc.Base64.stringify(wa)",
                "        .replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "}",
                "const now = Math.floor(Date.now()/1000);",
                "const hdr = JSON.stringify({ alg:'HS256', typ:'JWT' });",
                "const pld = JSON.stringify({",
                "    iss: pm.collectionVariables.get('jwtIssuer'),",
                "    sub: ACTOR, userId: ACTOR, role: ROLE, tokenType: 'USER',",
                "    iat: now, exp: now + 3600",
                "});",
                "const h = b64url(CryptoJS.enc.Utf8.parse(hdr));",
                "const p = b64url(CryptoJS.enc.Utf8.parse(pld));",
                "const si = h + '.' + p;",
                "const sig = b64url(CryptoJS.HmacSHA256(si, pm.collectionVariables.get('jwtSecret')));",
                "pm.variables.set('jwt', si + '.' + sig);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('403 Forbidden', () => pm.response.to.have.status(403));",
                "// Live-lookup proof lives in `docker compose logs menu-service`:",
                "// look for `ownership denial actor=...0002 ... ownerId=...0001`.",
                "// menu-service has no local copy of restaurant ownership, so",
                "// it could only have learned ownerId via GET restaurant-service:8081."
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman negative {{$timestamp}}\",\n  \"priceAmount\": 1.00,\n  \"priceCurrency\": \"EUR\",\n  \"category\": \"Main\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/menu-items", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "menu-items"] }
          }
        }
      ]
    },
    {
      "name": "B2B endpoints (consumed by Order Service in W1)",
      "item": [
        {
          "name": "GET /restaurants/{{restaurantId}}/availability  (customer token)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
"const ACTOR = pm.collectionVariables.get('userCustomer');",
                "const ROLE  = 'Customer';",
                "function b64url(wa) {",
                "    return CryptoJS.enc.Base64.stringify(wa)",
                "        .replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "}",
                "const now = Math.floor(Date.now()/1000);",
                "const hdr = JSON.stringify({ alg:'HS256', typ:'JWT' });",
                "const pld = JSON.stringify({",
                "    iss: pm.collectionVariables.get('jwtIssuer'),",
                "    sub: ACTOR, userId: ACTOR, role: ROLE, tokenType: 'USER',",
                "    iat: now, exp: now + 3600",
                "});",
                "const h = b64url(CryptoJS.enc.Utf8.parse(hdr));",
                "const p = b64url(CryptoJS.enc.Utf8.parse(pld));",
                "const si = h + '.' + p;",
                "const sig = b64url(CryptoJS.HmacSHA256(si, pm.collectionVariables.get('jwtSecret')));",
                "pm.variables.set('jwt', si + '.' + sig);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('isOpen present', () => pm.expect(j).to.have.property('isOpen'));",
                "pm.test('acceptsOrders present', () => pm.expect(j).to.have.property('acceptsOrders'));",
                "pm.test('checkedAt is ISO-8601 UTC', () => pm.expect(j.checkedAt).to.match(/^\\d{4}-\\d{2}-\\d{2}T.*Z$/));"
              ]}
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/availability", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "availability"] }
          }
        },
        {
          "name": "POST /menu-items/validate  (customer token; line-total math)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
"const ACTOR = pm.collectionVariables.get('userCustomer');",
                "const ROLE  = 'Customer';",
                "function b64url(wa) {",
                "    return CryptoJS.enc.Base64.stringify(wa)",
                "        .replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "}",
                "const now = Math.floor(Date.now()/1000);",
                "const hdr = JSON.stringify({ alg:'HS256', typ:'JWT' });",
                "const pld = JSON.stringify({",
                "    iss: pm.collectionVariables.get('jwtIssuer'),",
                "    sub: ACTOR, userId: ACTOR, role: ROLE, tokenType: 'USER',",
                "    iat: now, exp: now + 3600",
                "});",
                "const h = b64url(CryptoJS.enc.Utf8.parse(hdr));",
                "const p = b64url(CryptoJS.enc.Utf8.parse(pld));",
                "const si = h + '.' + p;",
                "const sig = b64url(CryptoJS.HmacSHA256(si, pm.collectionVariables.get('jwtSecret')));",
                "pm.variables.set('jwt', si + '.' + sig);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "const j = pm.response.json();",
                "pm.test('allValid is true', () => pm.expect(j.allValid).to.eql(true));",
                "pm.test('totalAmount = 17.00 (8.50 * 2)', () => pm.expect(Number(j.totalAmount)).to.eql(17.00));",
                "pm.test('currency EUR', () => pm.expect(j.currency).to.eql('EUR'));"
              ]}
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"menuItemId\": \"{{menuItemId}}\", \"quantity\": 2 }\n  ]\n}" },
            "url": { "raw": "{{gatewayUrl}}/menu-items/validate", "host": ["{{gatewayUrl}}"], "path": ["menu-items", "validate"] }
          }
        }
      ]
    },
    {
      "name": "Negative auth (JWT filter sanity)",
      "item": [
        {
          "name": "GET availability without token  (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/availability", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "availability"] }
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
              "const j = pm.response.json();",
              "pm.test('shared error envelope', () => { pm.expect(j).to.have.property('status', 401); pm.expect(j).to.have.property('error'); });"
            ]}
          }]
        },
        {
          "name": "GET availability with wrong-issuer token  (expect 401)",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": [
                "// Mint a token with the wrong issuer to prove requireIssuer(...) bites.",
"function b64url(wa) {",
                "    return CryptoJS.enc.Base64.stringify(wa)",
                "        .replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');",
                "}",
                "const now = Math.floor(Date.now()/1000);",
                "const ACTOR = pm.collectionVariables.get('userCustomer');",
                "const hdr = JSON.stringify({ alg:'HS256', typ:'JWT' });",
                "const pld = JSON.stringify({",
                "    iss: 'wrong-issuer', sub: ACTOR, userId: ACTOR,",
                "    role: 'Customer', tokenType: 'USER',",
                "    iat: now, exp: now + 3600",
                "});",
                "const h = b64url(CryptoJS.enc.Utf8.parse(hdr));",
                "const p = b64url(CryptoJS.enc.Utf8.parse(pld));",
                "const si = h + '.' + p;",
                "const sig = b64url(CryptoJS.HmacSHA256(si, pm.collectionVariables.get('jwtSecret')));",
                "pm.variables.set('jwt', si + '.' + sig);"
              ]}
            },
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
              ]}
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt}}" }],
            "url": { "raw": "{{gatewayUrl}}/restaurants/{{restaurantId}}/availability", "host": ["{{gatewayUrl}}"], "path": ["restaurants", "{{restaurantId}}", "availability"] }
          }
        }
      ]
    }
  ]
}
