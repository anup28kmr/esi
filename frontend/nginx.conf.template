# nginx config template. The frontend container only serves the SPA's
# static assets -- API calls go straight from the browser to the
# Spring Cloud Gateway (frontend -> api-gateway -> service), so this
# config has no reverse-proxy block. SPA history fallback only.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback: Vue Router uses HTML5 history mode. Any non-asset
    # path should be served `index.html` so the client-side router can
    # pick up the route.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
